# Drizzle
# Replace with your DB credentials!
DATABASE_URL="mysql://user:password@host:port/db-name"

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# HMAC key for NIK uniqueness checks (openssl rand -hex 32)
BETTER_AUTH_NIK_KEY=""

# Local development fallback when TiDB is unavailable. Omit in production.
AUTH_STORAGE="memory"
REQUIRE_EMAIL_VERIFICATION="false"
LOCAL_LURAH_EMAIL="lurah@example.test"
LOCAL_LURAH_NAME="Lurah Lokal"
LOCAL_LURAH_PASSWORD="change-this-local-password"
